build :
	cd BezierFreeForm2D    ; make CONFIG=$(CONFIG) -f ../makeapp.lnx APP=BezierFreeForm2D
	cd Boolean2D           ; make CONFIG=$(CONFIG) -f ../makeapp.lnx APP=Boolean2D
	cd BSplineFitDiscrete  ; make CONFIG=$(CONFIG) -f ../makeapp.lnx APP=BSplineFitDiscrete
	cd BSplineLeastSquares ; make CONFIG=$(CONFIG) -f ../makeapp.lnx APP=BSplineLeastSquares
	cd ClodPolyline        ; make CONFIG=$(CONFIG) -f ../makeapp.lnx APP=ClodPolyline
	cd ConvexHull2D        ; make CONFIG=$(CONFIG) -f ../makeapp.lnx APP=ConvexHull2D
	cd ConvexHull3D        ; make CONFIG=$(CONFIG) -f ../makeapp.lnx APP=ConvexHull3D
	cd Delaunay2D          ; make CONFIG=$(CONFIG) -f ../makeapp.lnx APP=Delaunay2D
	cd Delaunay3D          ; make CONFIG=$(CONFIG) -f ../makeapp.lnx APP=Delaunay3D
	cd DrawImplicitSurface ; make CONFIG=$(CONFIG) -f ../makeapp.lnx APP=DrawImplicitSurface
	cd GeodesicHeightField ; make CONFIG=$(CONFIG) -f ../makeapp.lnx APP=GeodesicHeightField
	cd GeodesicPaths       ; make CONFIG=$(CONFIG) -f ../makeapp.lnx APP=GeodesicPaths
	cd MapTextureToQuad    ; make CONFIG=$(CONFIG) -f ../makeapp.lnx APP=MapTextureToQuad
	cd MinimalCycleBasis   ; make CONFIG=$(CONFIG) -f ../makeapp.lnx APP=MinimalCycleBasis
	cd Polysolid2D         ; make CONFIG=$(CONFIG) -f ../makeapp.lnx APP=Polysolid2D
	cd QuadraticFreeForm2D ; make CONFIG=$(CONFIG) -f ../makeapp.lnx APP=QuadraticFreeForm2D
	cd Triangulation       ; make CONFIG=$(CONFIG) -f ../makeapp.lnx APP=Triangulation

clean :
	cd BezierFreeForm2D    ; make clean CONFIG=$(CONFIG) -f ../makeapp.lnx APP=BezierFreeForm2D
	cd Boolean2D           ; make clean CONFIG=$(CONFIG) -f ../makeapp.lnx APP=Boolean2D
	cd BSplineFitDiscrete  ; make clean CONFIG=$(CONFIG) -f ../makeapp.lnx APP=BSplineFitDiscrete
	cd BSplineLeastSquares ; make clean CONFIG=$(CONFIG) -f ../makeapp.lnx APP=BSplineLeastSquares
	cd ClodPolyline        ; make clean CONFIG=$(CONFIG) -f ../makeapp.lnx APP=ClodPolyline
	cd ConvexHull2D        ; make clean CONFIG=$(CONFIG) -f ../makeapp.lnx APP=ConvexHull2D
	cd ConvexHull3D        ; make clean CONFIG=$(CONFIG) -f ../makeapp.lnx APP=ConvexHull3D
	cd Delaunay2D          ; make clean CONFIG=$(CONFIG) -f ../makeapp.lnx APP=Delaunay2D
	cd Delaunay3D          ; make clean CONFIG=$(CONFIG) -f ../makeapp.lnx APP=Delaunay3D
	cd DrawImplicitSurface ; make clean CONFIG=$(CONFIG) -f ../makeapp.lnx APP=DrawImplicitSurface
	cd GeodesicHeightField ; make clean CONFIG=$(CONFIG) -f ../makeapp.lnx APP=GeodesicHeightField
	cd GeodesicPaths       ; make clean CONFIG=$(CONFIG) -f ../makeapp.lnx APP=GeodesicPaths
	cd MapTextureToQuad    ; make clean CONFIG=$(CONFIG) -f ../makeapp.lnx APP=MapTextureToQuad
	cd MinimalCycleBasis   ; make clean CONFIG=$(CONFIG) -f ../makeapp.lnx APP=MinimalCycleBasis
	cd Polysolid2D         ; make clean CONFIG=$(CONFIG) -f ../makeapp.lnx APP=Polysolid2D
	cd QuadraticFreeForm2D ; make clean CONFIG=$(CONFIG) -f ../makeapp.lnx APP=QuadraticFreeForm2D
	cd Triangulation       ; make clean CONFIG=$(CONFIG) -f ../makeapp.lnx APP=Triangulation
