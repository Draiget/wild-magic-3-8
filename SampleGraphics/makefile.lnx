build :
	cd BillboardNodes    ; make CONFIG=$(CONFIG) -f ../makeapp.lnx APP=BillboardNodes
	cd BspNodes          ; make CONFIG=$(CONFIG) -f ../makeapp.lnx APP=BspNodes
	cd BumpMaps          ; make CONFIG=$(CONFIG) -f ../makeapp.lnx APP=BumpMaps
	cd CachedArrays      ; make CONFIG=$(CONFIG) -f ../makeapp.lnx APP=CachedArrays
	cd Castle            ; make CONFIG=$(CONFIG) -f ../makeapp.lnx APP=Castle
	cd ClodMeshes        ; make CONFIG=$(CONFIG) -f ../makeapp.lnx APP=ClodMeshes
	cd ClodTerrains      ; make CONFIG=$(CONFIG) -f ../makeapp.lnx APP=ClodTerrains
	cd Collisions        ; make CONFIG=$(CONFIG) -f ../makeapp.lnx APP=Collisions
	cd DarkBumpMaps      ; make CONFIG=$(CONFIG) -f ../makeapp.lnx APP=DarkBumpMaps
	cd DeferredDraw      ; make CONFIG=$(CONFIG) -f ../makeapp.lnx APP=DeferredDraw
	cd DlodNodes         ; make CONFIG=$(CONFIG) -f ../makeapp.lnx APP=DlodNodes
	cd EnvironmentMaps   ; make CONFIG=$(CONFIG) -f ../makeapp.lnx APP=EnvironmentMaps
	cd GlossMaps         ; make CONFIG=$(CONFIG) -f ../makeapp.lnx APP=GlossMaps
	cd InverseKinematics ; make CONFIG=$(CONFIG) -f ../makeapp.lnx APP=InverseKinematics
	cd MaterialAlpha     ; make CONFIG=$(CONFIG) -f ../makeapp.lnx APP=MaterialAlpha
	cd MaterialTexture   ; make CONFIG=$(CONFIG) -f ../makeapp.lnx APP=MaterialTexture
	cd MorphControllers  ; make CONFIG=$(CONFIG) -f ../makeapp.lnx APP=MorphControllers
	cd Multitexture      ; make CONFIG=$(CONFIG) -f ../makeapp.lnx APP=Multitexture
	cd NonuniformScale   ; make CONFIG=$(CONFIG) -f ../makeapp.lnx APP=NonuniformScale
	cd ParticleSystems   ; make CONFIG=$(CONFIG) -f ../makeapp.lnx APP=ParticleSystems
	cd PlanarReflections ; make CONFIG=$(CONFIG) -f ../makeapp.lnx APP=PlanarReflections
	cd PlanarShadows     ; make CONFIG=$(CONFIG) -f ../makeapp.lnx APP=PlanarShadows
	cd PointSystems      ; make CONFIG=$(CONFIG) -f ../makeapp.lnx APP=PointSystems
	cd Polylines         ; make CONFIG=$(CONFIG) -f ../makeapp.lnx APP=Polylines
	cd Portals           ; make CONFIG=$(CONFIG) -f ../makeapp.lnx APP=Portals
	cd ProjectedTextures ; make CONFIG=$(CONFIG) -f ../makeapp.lnx APP=ProjectedTextures
	cd RenderToTexture   ; make CONFIG=$(CONFIG) -f ../makeapp.lnx APP=RenderToTexture
	cd ScreenPolygons    ; make CONFIG=$(CONFIG) -f ../makeapp.lnx APP=ScreenPolygons
	cd SkinnedBiped      ; make CONFIG=$(CONFIG) -f ../makeapp.lnx APP=SkinnedBiped
	cd SortFaces         ; make CONFIG=$(CONFIG) -f ../makeapp.lnx APP=SortFaces
	cd SurfaceMeshes     ; make CONFIG=$(CONFIG) -f ../makeapp.lnx APP=SurfaceMeshes
	cd SwitchNodes       ; make CONFIG=$(CONFIG) -f ../makeapp.lnx APP=SwitchNodes
	cd Terrains          ; make CONFIG=$(CONFIG) -f ../makeapp.lnx APP=Terrains

clean :
	cd BillboardNodes    ; make clean CONFIG=$(CONFIG) -f ../makeapp.lnx APP=BillboardNodes
	cd BspNodes          ; make clean CONFIG=$(CONFIG) -f ../makeapp.lnx APP=BspNodes
	cd BumpMaps          ; make clean CONFIG=$(CONFIG) -f ../makeapp.lnx APP=BumpMaps
	cd CachedArrays      ; make clean CONFIG=$(CONFIG) -f ../makeapp.lnx APP=CachedArrays
	cd Castle            ; make clean CONFIG=$(CONFIG) -f ../makeapp.lnx APP=Castle
	cd ClodMeshes        ; make clean CONFIG=$(CONFIG) -f ../makeapp.lnx APP=ClodMeshes
	cd ClodTerrains      ; make clean CONFIG=$(CONFIG) -f ../makeapp.lnx APP=ClodTerrains
	cd Collisions        ; make clean CONFIG=$(CONFIG) -f ../makeapp.lnx APP=Collisions
	cd DarkBumpMaps      ; make clean CONFIG=$(CONFIG) -f ../makeapp.lnx APP=DarkBumpMaps
	cd DeferredDraw      ; make clean CONFIG=$(CONFIG) -f ../makeapp.lnx APP=DeferredDraw
	cd DlodNodes         ; make clean CONFIG=$(CONFIG) -f ../makeapp.lnx APP=DlodNodes
	cd EnvironmentMaps   ; make clean CONFIG=$(CONFIG) -f ../makeapp.lnx APP=EnvironmentMaps
	cd GlossMaps         ; make clean CONFIG=$(CONFIG) -f ../makeapp.lnx APP=GlossMaps
	cd InverseKinematics ; make clean CONFIG=$(CONFIG) -f ../makeapp.lnx APP=InverseKinematics
	cd MaterialAlpha     ; make clean CONFIG=$(CONFIG) -f ../makeapp.lnx APP=MaterialAlpha
	cd MaterialTexture   ; make clean CONFIG=$(CONFIG) -f ../makeapp.lnx APP=MaterialTexture
	cd MorphControllers  ; make clean CONFIG=$(CONFIG) -f ../makeapp.lnx APP=MorphControllers
	cd Multitexture      ; make clean CONFIG=$(CONFIG) -f ../makeapp.lnx APP=Multitexture
	cd NonuniformScale   ; make clean CONFIG=$(CONFIG) -f ../makeapp.lnx APP=NonuniformScale
	cd ParticleSystems   ; make clean CONFIG=$(CONFIG) -f ../makeapp.lnx APP=ParticleSystems
	cd PlanarReflections ; make clean CONFIG=$(CONFIG) -f ../makeapp.lnx APP=PlanarReflections
	cd PlanarShadows     ; make clean CONFIG=$(CONFIG) -f ../makeapp.lnx APP=PlanarShadows
	cd PointSystems      ; make clean CONFIG=$(CONFIG) -f ../makeapp.lnx APP=PointSystems
	cd Polylines         ; make clean CONFIG=$(CONFIG) -f ../makeapp.lnx APP=Polylines
	cd Portals           ; make clean CONFIG=$(CONFIG) -f ../makeapp.lnx APP=Portals
	cd ProjectedTextures ; make clean CONFIG=$(CONFIG) -f ../makeapp.lnx APP=ProjectedTextures
	cd RenderToTexture   ; make clean CONFIG=$(CONFIG) -f ../makeapp.lnx APP=RenderToTexture
	cd ScreenPolygons    ; make clean CONFIG=$(CONFIG) -f ../makeapp.lnx APP=ScreenPolygons
	cd SkinnedBiped      ; make clean CONFIG=$(CONFIG) -f ../makeapp.lnx APP=SkinnedBiped
	cd SortFaces         ; make clean CONFIG=$(CONFIG) -f ../makeapp.lnx APP=SortFaces
	cd SurfaceMeshes     ; make clean CONFIG=$(CONFIG) -f ../makeapp.lnx APP=SurfaceMeshes
	cd SwitchNodes       ; make clean CONFIG=$(CONFIG) -f ../makeapp.lnx APP=SwitchNodes
	cd Terrains          ; make clean CONFIG=$(CONFIG) -f ../makeapp.lnx APP=Terrains
