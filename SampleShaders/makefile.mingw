build :
	cd CharcoalEffects ; make CONFIG=$(CONFIG) -f ../makeapp.mingw APP=CharcoalEffects
	cd Fresnel         ; make CONFIG=$(CONFIG) -f ../makeapp.mingw APP=Fresnel
	cd Iridescence     ; make CONFIG=$(CONFIG) -f ../makeapp.mingw APP=Iridescence
	cd Refraction      ; make CONFIG=$(CONFIG) -f ../makeapp.mingw APP=Refraction
	cd RipplingOcean   ; make CONFIG=$(CONFIG) -f ../makeapp.mingw APP=RipplingOcean
	cd Skinning        ; make CONFIG=$(CONFIG) -f ../makeapp.mingw APP=Skinning
	cd VertexNoise     ; make CONFIG=$(CONFIG) -f ../makeapp.mingw APP=VertexNoise

clean :
	cd CharcoalEffects ; make clean CONFIG=$(CONFIG) -f ../makeapp.mingw APP=CharcoalEffects
	cd Fresnel         ; make clean CONFIG=$(CONFIG) -f ../makeapp.mingw APP=Fresnel
	cd Iridescence     ; make clean CONFIG=$(CONFIG) -f ../makeapp.mingw APP=Iridescence
	cd Refraction      ; make clean CONFIG=$(CONFIG) -f ../makeapp.mingw APP=Refraction
	cd RipplingOcean   ; make clean CONFIG=$(CONFIG) -f ../makeapp.mingw APP=RipplingOcean
	cd Skinning        ; make clean CONFIG=$(CONFIG) -f ../makeapp.mingw APP=Skinning
	cd VertexNoise     ; make clean CONFIG=$(CONFIG) -f ../makeapp.mingw APP=VertexNoise
