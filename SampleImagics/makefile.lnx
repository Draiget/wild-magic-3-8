build :
	cd BinaryOperations   ; make CONFIG=$(CONFIG) -f ../makeapp.lnx APP=BinaryOperations
	cd ConformalMapping   ; make CONFIG=$(CONFIG) -f ../makeapp.lnx APP=ConformalMapping
	cd ExtractLevelCubes  ; make CONFIG=$(CONFIG) -f ../makeapp.lnx APP=ExtractLevelCubes
	cd ExtractLevelCurves ; make CONFIG=$(CONFIG) -f ../makeapp.lnx APP=ExtractLevelCurves
	cd ExtractLevelTetra  ; make CONFIG=$(CONFIG) -f ../makeapp.lnx APP=ExtractLevelTetra
	cd ImViewer           ; make CONFIG=$(CONFIG) -f ../makeapp.lnx APP=ImViewer
	cd VolumeRenderer     ; make CONFIG=$(CONFIG) -f ../makeapp.lnx APP=VolumeRenderer

clean :
	cd BinaryOperations   ; make clean CONFIG=$(CONFIG) -f ../makeapp.lnx APP=BinaryOperations
	cd ConformalMapping   ; make clean CONFIG=$(CONFIG) -f ../makeapp.lnx APP=ConformalMapping
	cd ExtractLevelCubes  ; make clean CONFIG=$(CONFIG) -f ../makeapp.lnx APP=ExtractLevelCubes
	cd ExtractLevelCurves ; make clean CONFIG=$(CONFIG) -f ../makeapp.lnx APP=ExtractLevelCurves
	cd ExtractLevelTetra  ; make clean CONFIG=$(CONFIG) -f ../makeapp.lnx APP=ExtractLevelTetra
	cd ImViewer           ; make clean CONFIG=$(CONFIG) -f ../makeapp.lnx APP=ImViewer
	cd VolumeRenderer     ; make clean CONFIG=$(CONFIG) -f ../makeapp.lnx APP=VolumeRenderer
