build :
	cd ScenePrinter ; make CONFIG=$(CONFIG) -f ../makeapp.lnx APP=ScenePrinter
	cd SimpleViewer ; make CONFIG=$(CONFIG) -f ../makeapp.lnx APP=SimpleViewer

clean :
	cd ScenePrinter ; make clean CONFIG=$(CONFIG) -f ../makeapp.lnx APP=ScenePrinter
	cd SimpleViewer ; make clean CONFIG=$(CONFIG) -f ../makeapp.lnx APP=SimpleViewer
